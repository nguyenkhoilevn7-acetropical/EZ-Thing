# Local pilot database; use a separate isolated PostgreSQL database in hosted environments.
DATABASE_URL=sqlite:///./ezthing.db
# Set COOKIE_SECURE=1 behind HTTPS before any non-local deployment.
COOKIE_SECURE=0

# Staging-only: BOTH values must be set to enable anonymous isolated demo sessions.
# Never set either in production; /api/auth/demo is 404 unless both match.
EZ_THING_ENVIRONMENT=development
EZ_THING_DEMO_MODE=0
